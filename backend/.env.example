# Copy to backend/.env and fill in. Never commit .env.
PORT=5001
# Comma-separated list of allowed browser origins
CORS_ORIGIN=http://localhost:3000

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=Anand@0408
DB_NAME=attest

# Auth (generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))")
JWT_SECRET=200c66dd7e9de29426a1c054f436c92b3268afb53ca116ac50974404d6b2523cbcc97d1f543ae5cec1140cc336e65947
JWT_EXPIRES_IN=8h

# Blockchain. CONTRACT_ADDRESS is optional: if empty, ../deployment.json (written by `npm run deploy`) is used.
RPC_URL=http://127.0.0.1:8545
CONTRACT_ADDRESS=
# Optional: sign with this key instead of the node's first unlocked account (needed on a real network)
CHAIN_PRIVATE_KEY=

# Deepfake analysis
PYTHON_BIN=python3
DEEPFAKE_ENABLED=true
